{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercaba.org/atlas/schemas/library.schema.json",
  "title": "Atlas Library",
  "type": "object",
  "required": ["id", "folder", "short", "mark", "tone", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "folder": { "type": "string", "pattern": "^\\d{2,}_IA_.+" },
    "short": { "type": "string", "minLength": 2 },
    "mark": { "type": "string", "minLength": 1, "maxLength": 3 },
    "tone": { "type": "string" },
    "notebookUrl": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean", "default": true }
  },
  "additionalProperties": true
}
